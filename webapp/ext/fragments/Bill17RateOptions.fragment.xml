<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox 
    class="sapUiNoMargin sapUiNoContentPadding"
    visible="{= ${site_plan_approved_date} !== null }"
    >

        <List
            items="{path: 'to_bill17rtopt'}"
            showSeparators="None"
            backgroundDesign="Transparent"
            class="sapUiNoMargin sapUiNoContentPadding">

            <CustomListItem class="sapUiNoContentPadding">
                <VBox class="sapUiNoMargin sapUiNoContentPadding">

                    <Text
                        text="{name}"
                        design="Bold"
                        class="sapUiTinyMarginBottom"/>

                    <RadioButtonGroup
                        columns="2"
                        enabled="{= ${ui>/editable} }"
                        selectedIndex="{
                            path: 'calc_option',
                            formatter: '.formatCalcOptionToIndex'
                        }"
                        select=".onCalcOptionChange"
                        class="sapUiNoMargin">

                        <buttons>
                            <RadioButton text="Locked"/>
                            <RadioButton text="Prevailing"/>
                        </buttons>

                    </RadioButtonGroup>

                </VBox>
            </CustomListItem>

        </List>

    </VBox>

</core:FragmentDefinition>
