<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <VBox
        id="_IDGenVBox2"
        class="sapUiNoMargin sapUiNoContentPadding"
        visible="{= ${site_plan_applied_date} !== null }"
    >
        <List
            id="idBill17List"
            items="{
                path: 'to_bill17rtopt', 
                templateShareable: false,
                sorter: {
                    path: 'id',
                    descending: false
                }
            }"
            showSeparators="None"
            backgroundDesign="Transparent"
            class="sapUiNoMargin sapUiNoContentPadding"
        >
            <CustomListItem
                id="_IDGenCustomListItem"
                class="sapUiNoContentPadding"
            >
                <VBox
                    id="_IDGenVBox3"
                    class="sapUiNoMargin sapUiNoContentPadding"
                >
                  <Label id="_IDGenLabel" text="{name}" design="Bold" class="sapUiTinyMarginBottom"/>

                    <RadioButtonGroup
                        id="_IDGenRadioButtonGroup"
                        columns="2"
                        enabled="{= ${ui>/editable} &amp;&amp; ${LocalModel>/isBill17Editable} }"
                        selectedIndex="{
        path: 'calc_option',
        formatter: '.formatCalcOptionToIndex'
    }"
                        select=".onCalcOptionChange"
                        class="sapUiNoMargin"
                    >
                        <buttons>
                            <RadioButton
                                id="_IDGenRadioButton"
                                text="{i18n>textLocked}"
                            />
                            <RadioButton
                                id="_IDGenRadioButton1"
                                text="{i18n>textPrevailing}"
                            />
                        </buttons>
                    </RadioButtonGroup>
                </VBox>
            </CustomListItem>
        </List>
    </VBox>
</core:FragmentDefinition>
