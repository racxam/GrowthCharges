<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:commons="sap.suite.ui.commons"
    xmlns:l="sap.ui.layout"
    xmlns:smartField="sap.ui.comp.smartfield">
    <VBox id="_IDGenVBox1" wrap="Wrap" fitContainer="true">
        <l:HorizontalLayout id="_IDGenHorizontalLayout1">
            <ObjectStatus id="_IDGenObjectStatus0" title="{i18n>objHeaderTextVersion}" text="{version}" class="sapUiMediumMarginBegin sapUiMediumMarginBottom"/>
            <ObjectStatus id="_IDGenObjectStatus1" title="{i18n>objHeaderTextDCID}" text="{request_id}" class="sapUiMediumMarginBegin sapUiMediumMarginBottom"/>
            <ObjectStatus id="_IDGenObjectStatus2" title="{i18n>objHeaderTextPermitNo}" text="{permit}" class="sapUiMediumMarginBegin sapUiMediumMarginBottom"/>
            <ObjectStatus id="_IDGenObjectStatus3" title="{i18n>objHeaderTextAddress}" text="{street}" class="sapUiMediumMarginBegin sapUiMediumMarginBottom"/>
        </l:HorizontalLayout>
        <commons:MicroProcessFlow id="_IDGenMicroProcessFlow1">
            <commons:content>
                <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem1" showSeparator="{cil_applicable}" press=".openMilestoneDialog($event,'CIL')">
                    <commons:customControl>
                        <ObjectStatus id="_IDGenObjectStatus5" text="{i18n>titleCIL}" state="{ path: 'status', formatter: '.getStatusStateForCIL' }" inverted="true" visible="{cil_applicable}" />
                    </commons:customControl>
                </commons:MicroProcessFlowItem>
                <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem2" showSeparator="{dc_applicable}" press=".openMilestoneDialog($event,'DC')">
                    <commons:customControl>
                        <ObjectStatus id="_IDGenObjectStatus6" text="{i18n>titleDC}" state="{ path: 'status', formatter: '.getStatusStateForDC' }" inverted="true" visible="{dc_applicable}"/>
                    </commons:customControl>
                </commons:MicroProcessFlowItem>
                <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem3" showSeparator="{cbc_applicable}" press=".openMilestoneDialog($event,'CBC')">
                    <commons:customControl>
                        <ObjectStatus id="_IDGenObjectStatus7" text="{i18n>titleCBC}" state="{ path: 'status', formatter: '.getStatusStateForCBC' }" inverted="true" visible="{cbc_applicable}" />
                    </commons:customControl>
                </commons:MicroProcessFlowItem>
                <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItemPCLSD" showSeparator="{=${status} === 'PCLSD'}" state="{ path: 'status', formatter: '.showStatusPClosed' }" visible="{=${status} === 'PCLSD'}" press=".openMilestoneDialog($event,'PCLSD')">
                    <commons:customControl>
                        <ObjectStatus id="_IDGenObjectStatusPCLSD" text="{i18n>titlePartialClosed}" state="{ path: 'status', formatter: '.showStatusPClosed' }" inverted="true"/>
                    </commons:customControl>
                </commons:MicroProcessFlowItem>

                <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem4" showSeparator="{=${status} === 'CLSD'}" press=".openMilestoneDialog($event,'CLSD')">
                    <commons:customControl>
                        <ObjectStatus id="_IDGenObjectStatus8" text="{i18n>titleClosed}" state="{ path: 'status', formatter: '.getStatusStateForClosed' }" inverted="true" visible="{=${status} === 'CLSD'}"/>
                    </commons:customControl>
                </commons:MicroProcessFlowItem>
                <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem5" showSeparator="{=${status} === 'HLD'}" press=".openMilestoneDialog($event,'HLD')">
                    <commons:customControl>
                        <ObjectStatus id="_IDGenObjectStatus9" text="{i18n>titleHold}" state="{ path: 'status', formatter: '.getStatusStateForHold' }" inverted="true" visible="{=${status} === 'HLD'}"/>
                    </commons:customControl>
                </commons:MicroProcessFlowItem>
                <!-- <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem4" state="{ path: 'status', formatter: '.getStatusStateForClosed' }" icon="sap-icon://paid-leave"/>  
            <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem5" state="{ path: 'status', formatter: '.getStatusStateForHold' }" icon="sap-icon://media-pause"/> -->
            </commons:content>
        </commons:MicroProcessFlow>
    </VBox>
</core:FragmentDefinition>
