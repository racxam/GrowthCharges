<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:commons="sap.suite.ui.commons"
>
    <HBox id="_IDHBoxDCId">
        <core:Icon
            id="iconNewDC"
            class="sapUiSmallMarginBegin"
            useIconTooltip="true"
            tooltip="{i18n>tooltipIconNewDC}"
            src="sap-icon://alert"
            visible="{new_version}"
            color="#333333"
        />
    </HBox>
    <HBox
        id="_IDHBoxAppCharges"
        justifyContent="SpaceBetween"
    >
        <Text
            id="textApplCharges"
            text="{parts : [{path:'dc_applicable'},{path:'cil_applicable'},{path: 'cbc_applicable'}] ,formatter: '.showApplicationCharges'}"
        />
        <core:Icon
            id="iconValidUntil"
            class="sapUiSmallMarginBegin"
            useIconTooltip="true"
            tooltip="{i18n>tooltipiconValidUntil}"
            src="sap-icon://alert"
            visible="{parts : [{path:'invoice_valid_until'}] ,formatter: '.showInvoiceValidIcon'}"
            color="#E69A17"
        />
    </HBox>
    <Button
        id="_IDGenButton1"
        icon="sap-icon://comment"
        visible="{  path: 'dc_int_comments_sap' ,formatter: '.showDCComments' }"
        press=".onPressComments($event,'DC')"
    />
    <Button
        id="_IDGenButton2"
        icon="sap-icon://comment"
        visible="{  path: 'cbcComments' ,formatter: '.showCBCComments' }"
        press=".onPressComments($event,'CBC')"
    />
    <Button
        id="_IDGenButton3"
        icon="sap-icon://comment"
        visible="{  path: 'cilComments' ,formatter: '.showCILComments' }"
        press=".onPressComments($event,'CIL')"
    />
    <!-- Pills color coding -->
    <commons:MicroProcessFlow id="_IDGenMicroProcessFlow1">
            <commons:content>
                
                <commons:MicroProcessFlowItem 
                    id="ObjPage_CIL" 
                    visible="{cil_applicable}"
                    state="{ path: 'status', formatter: '.getStatusStateForCIL' }" 
                    press=".openMilestoneDialog($event,'CIL')"
                    showSeparator="{
                        parts: [
                            {path: 'dc_applicable'},
                            {path: 'to_defpartner'}, 
                            {path: 'cbc_applicable'},
                            {path: 'status'}
                        ],
                        formatter: '.getSeparatorForCIL'
                    }">
                    <commons:customControl>
                        <ObjectStatus text="{i18n>titleCIL}" state="{ path: 'status', formatter: '.getStatusStateForCIL' }" inverted="true" visible="{cil_applicable}" />
                    </commons:customControl>
                </commons:MicroProcessFlowItem>

                <commons:MicroProcessFlowItem 
                    id="ObjPage_DC" 
                    visible="{
                        parts: [
                            {path: 'dc_applicable'},
                            {path: 'to_defpartner'} 
                        ],
                        formatter: '._isDCPillVisible'
                    }"
                    state="{ path: 'status', formatter: '.getStatusStateForDC' }" 
                    press=".openMilestoneDialog($event,'DC')"
                    showSeparator="{
                        parts: [
                            {path: 'to_defpartner'}, 
                            {path: 'cbc_applicable'},
                            {path: 'status'}
                        ],
                        formatter: '.getSeparatorForDC'
                    }">
                    <commons:customControl>
                        <ObjectStatus text="{i18n>titleDC}" state="{ path: 'status', formatter: '.getStatusStateForDC' }" inverted="true" />
                    </commons:customControl>
                </commons:MicroProcessFlowItem>

                <commons:MicroProcessFlowItem 
                    id="ObjPage_Bill17"
                    visible="{
                        parts: [
                            {path: 'to_defpartner'}, 
                            {path: 'status'}
                        ],
                        formatter: '._isBill17PillVisible'
                    }"
                    state="{path: 'status', formatter: '.getBill17Level1State'}"
                    showSeparator="{
                        parts: [
                            {path: 'to_defpartner'},
                            {path: 'cbc_applicable'},
                            {path: 'status'}
                        ],
                        formatter: '.getSeparatorForBill17'
                    }">
                    <commons:customControl>
                        <ObjectStatus 
                            text="{path: 'status', formatter: '.getBill17Level1Text'}" 
                            state="{path: 'status', formatter: '.getBill17Level1State'}" 
                            inverted="true" />
                    </commons:customControl>
                </commons:MicroProcessFlowItem>

                <commons:MicroProcessFlowItem 
                    id="ObjPage_Bill17_Final"
                    visible="{
                        parts: [
                            {path: 'to_defpartner'}, 
                            {path: 'status'}
                        ],
                        formatter: '._isBill17FinalPillVisible'
                    }"
                    state="{path: 'status', formatter: '.getBill17FinalPillState'}"
                    showSeparator="{
                        parts: [
                            {path: 'cbc_applicable'},
                            {path: 'status'}
                        ],
                        formatter: '.getSeparatorForBill17Final'
                    }">
                    <commons:customControl>
                        <ObjectStatus 
                            text="{path: 'status', formatter: '.getBill17FinalPillText'}" 
                            state="{path: 'status', formatter: '.getBill17FinalPillState'}" 
                            inverted="true" />
                    </commons:customControl>
                </commons:MicroProcessFlowItem>

                <commons:MicroProcessFlowItem 
                    id="ObjPage_CBC" 
                    visible="{cbc_applicable}"
                    state="{ path: 'status', formatter: '.getStatusStateForCBC' }" 
                    press=".openMilestoneDialog($event,'CBC')"
                    showSeparator="{path: 'status', formatter: '.getSeparatorForCBC'}">
                    <commons:customControl>
                        <ObjectStatus text="{i18n>titleCBC}" state="{ path: 'status', formatter: '.getStatusStateForCBC' }" inverted="true" visible="{cbc_applicable}" />
                    </commons:customControl>
                </commons:MicroProcessFlowItem>

                <commons:MicroProcessFlowItem id="ObjPage_PCLSD" showSeparator="{=${status} === 'CLSD' || ${status} === 'HLD'}" state="{ path: 'status', formatter: '.showStatusPClosed' }" visible="{=${status} === 'PCLSD'}" press=".openMilestoneDialog($event,'PCLSD')">
                    <commons:customControl>
                        <ObjectStatus text="{i18n>titlePartialClosed}" state="{ path: 'status', formatter: '.showStatusPClosed' }" inverted="true"/>
                    </commons:customControl>
                </commons:MicroProcessFlowItem>

                <commons:MicroProcessFlowItem id="ObjPage_CLSD" showSeparator="{=${status} === 'PCLSD' || ${status} === 'HLD'}" press=".openMilestoneDialog($event,'CLSD')" visible="{=${status} === 'CLSD'}">
                    <commons:customControl>
                        <ObjectStatus text="{i18n>titleClosed}" state="{ path: 'status', formatter: '.getStatusStateForClosed' }" inverted="true" visible="{=${status} === 'CLSD'}"/>
                    </commons:customControl>
                </commons:MicroProcessFlowItem>

                <commons:MicroProcessFlowItem id="ObjPage_HLD" showSeparator="false" press=".openMilestoneDialog($event,'HLD')" visible="{=${status} === 'HLD'}">
                    <commons:customControl>
                        <ObjectStatus text="{i18n>titleHold}" state="{ path: 'status', formatter: '.getStatusStateForHold' }" inverted="true" visible="{=${status} === 'HLD'}"/>
                    </commons:customControl>
                </commons:MicroProcessFlowItem>

            </commons:content>
        </commons:MicroProcessFlow>
<!-- Pills color coding end -->

</core:FragmentDefinition>
