<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:commons="sap.suite.ui.commons"
>
    <HBox id="_IDHBoxDCId">
        <core:Icon
            id="iconNewDC"
            class="sapUiSmallMarginBegin"
            useIconTooltip="true"
            tooltip="{i18n>tooltipIconNewDC}"
            src="sap-icon://alert"
            visible="{new_version}"
            color="#333333"
        />
    </HBox>
    <HBox
        id="_IDHBoxAppCharges"
        justifyContent="SpaceBetween"
    >
        <Text
            id="textApplCharges"
            text="{parts : [{path:'dc_applicable'},{path:'cil_applicable'},{path: 'cbc_applicable'}] ,formatter: '.showApplicationCharges'}"
        />
        <core:Icon
            id="iconValidUntil"
            class="sapUiSmallMarginBegin"
            useIconTooltip="true"
            tooltip="{i18n>tooltipiconValidUntil}"
            src="sap-icon://alert"
            visible="{parts : [{path:'invoice_valid_until'}] ,formatter: '.showInvoiceValidIcon'}"
            color="#E69A17"
        />
    </HBox>
    <Button
        id="_IDGenButton1"
        icon="sap-icon://comment"
        visible="{  path: 'dc_int_comments_sap' ,formatter: '.showDCComments' }"
        press=".onPressComments($event,'DC')"
    />
    <Button
        id="_IDGenButton2"
        icon="sap-icon://comment"
        visible="{  path: 'cbcComments' ,formatter: '.showCBCComments' }"
        press=".onPressComments($event,'CBC')"
    />
    <Button
        id="_IDGenButton3"
        icon="sap-icon://comment"
        visible="{  path: 'cilComments' ,formatter: '.showCILComments' }"
        press=".onPressComments($event,'CIL')"
    />
    <commons:MicroProcessFlow id="_IDGenMicroProcessFlow1">
   <commons:content>
            
            <commons:MicroProcessFlowItem 
                id="_IDGenMicroProcessFlowItem1" 
                visible="{cil_applicable}"
                state="{ path: 'status', formatter: '.getStatusStateForCIL' }" 
                showSeparator="{
                    parts: [
                        {path: 'dc_applicable'},
                        {path: 'bill17_hidden'},
                        {path: 'cbc_applicable'},
                        {path: 'status'}
                    ],
                    formatter: '.getSeparatorForCIL'
                }">
                <commons:customControl>
                    <ObjectStatus id="_IDGenObjectStatus1" text="{i18n>titleCIL}" state="{ path: 'status', formatter: '.getStatusStateForCIL' }" inverted="true"/>
                </commons:customControl>
            </commons:MicroProcessFlowItem>

            <commons:MicroProcessFlowItem 
                id="_IDGenMicroProcessFlowItem2" 
                visible="{dc_applicable}"
                state="{ path: 'status', formatter: '.showStatusDC' }" 
                showSeparator="{
                    parts: [
                        {path: 'bill17_hidden'},
                        {path: 'cbc_applicable'},
                        {path: 'status'}
                    ],
                    formatter: '.getSeparatorForDC'
                }">
                <commons:customControl>
                    <ObjectStatus id="_IDGenObjectStatus2" text="{i18n>titleDC}" state="{ path: 'status', formatter: '.showStatusDC' }" inverted="true"/>
                </commons:customControl>
            </commons:MicroProcessFlowItem>

            <commons:MicroProcessFlowItem 
                visible="{
                    parts: [
                        {path: 'bill17_hidden'},
                        {path: 'status'}
                    ],
                    formatter: '._isBill17PillVisible'
                }"
                state="{path: 'status', formatter: '.getBill17Level1State'}"
                showSeparator="{
                    parts: [
                        {path: 'cbc_applicable'},
                        {path: 'status'}
                    ],
                    formatter: '.getSeparatorForBill17'
                }">
                <commons:customControl>
                    <ObjectStatus 
                        text="{path: 'status', formatter: '.getBill17Level1Text'}" 
                        state="{path: 'status', formatter: '.getBill17Level1State'}" 
                        inverted="true" />
                </commons:customControl>
            </commons:MicroProcessFlowItem>

            <commons:MicroProcessFlowItem 
                id="_IDGenMicroProcessFlowItem3" 
                visible="{cbc_applicable}"
                state="{ path: 'status', formatter: '.showStatusCBC' }" 
                showSeparator="{path: 'status', formatter: '.getSeparatorForCBC'}">
                <commons:customControl>
                    <ObjectStatus id="_IDGenObjectStatus3" text="{i18n>titleCBC}" state="{ path: 'status', formatter: '.showStatusCBC' }" inverted="true"/>
                </commons:customControl>
            </commons:MicroProcessFlowItem>

            <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItemPCLSD" showSeparator="{=${status} === 'CLSD' || ${status} === 'HLD'}" state="{ path: 'status', formatter: '.showStatusPClosed' }" visible="{=${status} === 'PCLSD'}">
                <commons:customControl>
                    <ObjectStatus id="_IDGenObjectStatusPCLSD" text="{i18n>titlePartialClosed}" state="{ path: 'status', formatter: '.showStatusPClosed' }" inverted="true"/>
                </commons:customControl>
            </commons:MicroProcessFlowItem>
            
            <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem4" showSeparator="{=${status} === 'PCLSD' || ${status} === 'HLD'}" state="{ path: 'status', formatter: '.showStatusClosed' }" visible="{=${status} === 'CLSD'}">
                <commons:customControl>
                    <ObjectStatus id="_IDGenObjectStatus4" text="{i18n>titleClosed}" state="{ path: 'status', formatter: '.showStatusClosed' }" inverted="true"/>
                </commons:customControl>
            </commons:MicroProcessFlowItem>
            
            <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem5" showSeparator="false" state="{ path: 'status', formatter: '.showStatusHold' }" visible="{=${status} === 'HLD'}">
                <commons:customControl>
                    <ObjectStatus id="_IDGenObjectStatus5" text="{i18n>titleHold}" state="{ path: 'status', formatter: '.showStatusHold' }" inverted="true"/>
                </commons:customControl>
            </commons:MicroProcessFlowItem>

        </commons:content>
   </commons:MicroProcessFlow>

</core:FragmentDefinition>
