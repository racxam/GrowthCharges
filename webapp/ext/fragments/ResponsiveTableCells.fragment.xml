<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:commons="sap.suite.ui.commons">
    <Text text="{parts : [{path:'dc_applicable'},{path:'cil_applicable'},{path: 'cbc_applicable'}] ,formatter: '.showApplicationCharges'}" />
    <Button id="_IDGenButton1" icon="sap-icon://comment" visible="{  path: 'dc_int_comments_sap' ,formatter: '.showDCComments' }" press=".onPressComments($event,'DC')"/>
    <Button id="_IDGenButton2" icon="sap-icon://comment" visible="{  path: 'cbcComments' ,formatter: '.showCBCComments' }" press=".onPressComments($event,'CBC')"/>
    <Button id="_IDGenButton3" icon="sap-icon://comment" visible="{  path: 'cilComments' ,formatter: '.showCILComments' }" press=".onPressComments($event,'CIL')"/>
    <commons:MicroProcessFlow id="_IDGenMicroProcessFlow1">
        <commons:content>
            <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem1" state="{ path: 'status', formatter: '.showStatusCIL' }" visible="{ path: 'cil_applicable' ,formatter: '.showCILStatusIcon' }">
                <commons:customControl>
                    <ObjectStatus id="_IDGenObjectStatus1" text="{i18n>titleCIL}" state="{ path: 'status', formatter: '.showStatusCIL' }" inverted="true"/>
                </commons:customControl>
            </commons:MicroProcessFlowItem>
            <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem2" state="{ path: 'status', formatter: '.showStatusDC' }" visible="{  path: 'dc_applicable' ,formatter: '.showDCStatusIcon' }">
                <commons:customControl>
                    <ObjectStatus id="_IDGenObjectStatus2" text="{i18n>titleDC}" state="{ path: 'status', formatter: '.showStatusDC' }" inverted="true"/>
                </commons:customControl>
            </commons:MicroProcessFlowItem>
            <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem3" state="{ path: 'status', formatter: '.showStatusCBC' }" visible="{  path: 'cbc_applicable' ,formatter: '.showCBCStatusIcon' }">
                <commons:customControl>
                    <ObjectStatus id="_IDGenObjectStatus3" text="{i18n>titleCBC}" state="{ path: 'status', formatter: '.showStatusCBC' }" inverted="true"/>
                </commons:customControl>
            </commons:MicroProcessFlowItem>

            <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem4" state="{ path: 'status', formatter: '.showStatusClosed' }" >
                <commons:customControl>
                    <ObjectStatus id="_IDGenObjectStatus4" text="{i18n>titleClosed}" state="{ path: 'status', formatter: '.showStatusClosed' }" inverted="true"/>
                </commons:customControl>
            </commons:MicroProcessFlowItem>

            <commons:MicroProcessFlowItem id="_IDGenMicroProcessFlowItem5" state="{ path: 'status', formatter: '.showStatusHold' }" >
                <commons:customControl>
                    <ObjectStatus id="_IDGenObjectStatus5" text="{i18n>titleHold}" state="{ path: 'status', formatter: '.showStatusHold' }" inverted="true"/>
                </commons:customControl>
            </commons:MicroProcessFlowItem>

            <!-- <commons:MicroProcessFlowItem state="{ path: 'status', formatter: '.showStatusClosed' }" icon="sap-icon://paid-leave"/>
            <commons:MicroProcessFlowItem state="{ path: 'status', formatter: '.showStatusHold' }" icon="sap-icon://media-pause"/> -->
        </commons:content>
    </commons:MicroProcessFlow>
</core:FragmentDefinition>