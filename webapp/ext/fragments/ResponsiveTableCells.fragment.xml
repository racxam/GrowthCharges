<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:commons="sap.suite.ui.commons">
    <!--Column 1 Cell-->
    <Button icon="sap-icon://comment" press=".onPressComments($event,'DC')"/>
     <!--Column 2 Cell-->
    <Button icon="sap-icon://comment" press=".onPressComments($event,'CBC')"/>
     <!--Column 3 Cell-->
    <Button icon="./img/CIL.png" press=".onPressComments($event,'CIL')"/>
     <!--Column 4 Cell-->
    <commons:MicroProcessFlow>
        <commons:content>
            <commons:MicroProcessFlowItem state="{ path: 'status', formatter: '.showStatusCIL' }"  >
             <commons:customControl>
             <!-- icon="./img/CIL.png" -->
                <ObjectStatus text="CIL" state="{ path: 'status', formatter: '.showStatusCIL' }" />
                </commons:customControl>
                </commons:MicroProcessFlowItem> 
            <commons:MicroProcessFlowItem state="{ path: 'status', formatter: '.showStatusDC' }" >
            <commons:customControl>
            <!--icon="./img/CIL.png"-->
                <ObjectStatus text="DC" state="{ path: 'status', formatter: '.showStatusDC' }" />
                </commons:customControl>
                </commons:MicroProcessFlowItem> 
            <commons:MicroProcessFlowItem state="{ path: 'status', formatter: '.showStatusCBC' }" >
             <commons:customControl>
             <!--icon="./img/CIL.png"-->
                <ObjectStatus text="CBC" state="{ path: 'status', formatter: '.showStatusCBC' }" />
                </commons:customControl>
                 </commons:MicroProcessFlowItem> 
            <commons:MicroProcessFlowItem state="{ path: 'status', formatter: '.showStatusRefund' }" icon="sap-icon://opportunities"/>
            <commons:MicroProcessFlowItem state="{ path: 'status', formatter: '.showStatusPayment' }" icon="sap-icon://paid-leave">
            <commons:customControl>
                <!-- <Image width="30%" src="./img/CIL.png"/> -->
                <!-- <ObjectStatus
			class="sapUiSmallMarginBottom"
			text="CIL"
			icon="./img/CIL.png"
			state="{ path: 'status', formatter: '.showStatusPayment' }" /> -->
                </commons:customControl>
            </commons:MicroProcessFlowItem>   
        </commons:content>
    </commons:MicroProcessFlow>
</core:FragmentDefinition>