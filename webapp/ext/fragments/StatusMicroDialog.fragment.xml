<core:FragmentDefinition xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout">
	<Popover busy="{global>/busy}" contentMinWidth="250px" busyIndicatorDelay="0" showHeader="false" class="sapUiResponsiveContentPadding" placement="VerticalPreferredBottom" modal="false">
		<HBox class="sapUiSmallTinyBottom">
			<Label text="{i18n>labelCurrentStatus} :"/>
			<Text text="{StatusModel>/action}" />
		</HBox>
		<HBox class="sapUiSmallTinyBottom">
			<Label text="{i18n>labelActionDate} :"/>
			<Text text="{ path:'StatusModel>/action_on',type:'sap.ui.model.type.DateTime', formatOptions: {pattern:'dd.MM.yyyy',UTC: true}}" />
		</HBox>
		<HBox class="sapUiSmallTinyBottom">
			<Label text="{i18n>labelActionBy} :"/>
			<Text text="{StatusModel>/action_by_Text}"/>
		</HBox>
	</Popover>

</core:FragmentDefinition>