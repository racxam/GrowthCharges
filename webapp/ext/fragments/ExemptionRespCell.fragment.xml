<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <HBox alignItems="Center" justifyContent="End" width="100%">
        
        <core:Icon 
            src="sap-icon://alert" 
            visible="{is_rate_edited}" 
            color="#E69A17" 
            class="sapUiSmallMarginEnd" 
            tooltip="{i18n>rate_edited}" />

        <Input 
            value="{dc_rate}" 
            showValueHelp="true" 
            valueHelpRequest=".onValueHelpRequested" 
            visible="{= ${ui>/editable} &amp;&amp; ${Update_mc}}" />
            
        <Text 
            text="{dc_rate}" 
            visible="{= !${ui>/editable} || !${Update_mc}}" />
            
    </HBox>
</core:FragmentDefinition>